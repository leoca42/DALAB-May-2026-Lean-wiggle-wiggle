   "metadata": {},
   "outputs": [],
   "source": [
    "# ── Scan dataset rows for typeclass brackets [TC ...] ─────────────────────────\n",
    "# Only rows with at least one capitalised [TC] bracket can produce TC variants.\n",
    "\n",
    "import re as _re\n",
    "_TC_SCAN = _re.compile(\n",
    "    r'\\['\n",
    "    r'(?:[A-Za-z_][A-Za-z0-9_]*\\s*:\\s*)?'\n",
    "    r'([A-Z][A-Za-z0-9_.]+)'\n",
    "    r'[^\\[\\]]*\\]'\n",
    ")\n",
    "\n",
    "print(\"Typeclass bracket scan:\")\n",
    "print(\"-\" * 65)\n",
    "_eligible = []\n",
    "for _idx, _row in df.iterrows():\n",
    "    _tcs = [m.group(1) for m in _TC_SCAN.finditer(_row[\"type\"])]\n",
    "    _flag = \"\\u2713 eligible\" if _tcs else \"  (no TC)\"\n",
    "    print(f\"  Row {_idx:>6}  {_flag}   {_tcs}\")\n",
    "    if _tcs:\n",
    "        _eligible.append(_idx)\n",
    "print(\"-\" * 65)\n",
    "print(f\"Eligible: {_eligible}  ({len(_eligible)}/{len(df)} rows)\")\n",
    "\n",
    "df_tc = df.loc[_eligible] if _eligible else df.iloc[:0]"
   ]
