    "# ── Typeclass mutation — imports, propagation rules, transform dicts ──────────\n",
    "#\n",
    "# Loads four methods from typeclass_mutate.py that systematically shift a\n",
    "# theorem's generalization level by replacing one typeclass in the Mathlib\n",
    "# typeclass hierarchy with a parent (weaker) or child (stronger) class.\n",
    "#\n",
    "# Method                                       | TC position | TC direction | Effect\n",
    "# ──────────────────────────────────────────────────────────────────────────────\n",
    "# generalize_statement_by_weakening_hypotheses | hypothesis  | UP (weaker)  | more general\n",
    "# weaken_statement_by_strengthening_hypotheses | hypothesis  | DOWN (strong)| weaker\n",
    "# strengthen_statement_by_strengthening_conclusion | conclusion | DOWN (strong)| stronger\n",
    "# weaken_statement_by_weakening_conclusion     | conclusion  | UP (weaker)  | weaker\n",
    "\n",
    "import sys as _sys\n",
    "_sys.path.insert(0, os.path.abspath(\".\"))\n",
    "\n",
    "try:\n",
    "    from typeclass_mutate import (\n",
    "        generalize_statement_by_weakening_hypotheses  as _tc_gen_hyp,\n",
    "        weaken_statement_by_strengthening_hypotheses  as _tc_wk_hyp,\n",
    "        strengthen_statement_by_strengthening_conclusion as _tc_str_conc,\n",
    "        weaken_statement_by_weakening_conclusion      as _tc_wk_conc,\n",
    "    )\n",
    "    _TC_IMPORT_OK = True\n",
    "except ImportError as _e:\n",
    "    print(f\"WARNING: could not import typeclass_mutate — {_e}\")\n",
    "    print(\"Place typeclass_mutate.py in the project root and re-run this cell.\")\n",
    "    _TC_IMPORT_OK = False\n",
    "\n",
