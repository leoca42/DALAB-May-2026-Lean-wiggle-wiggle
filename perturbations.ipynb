    "        (r'(>\\s*)(\\d+)',  +1, \"bound_perturbation_tighter\"),\n",
    "        (r'(<\\s*)(\\d+)',  -1, \"bound_perturbation_tighter\"),\n",
    "    ]\n",
    "    for pat, delta, _ in specs:\n",
    "        m = re.search(pat, type_str)\n",
    "        if m:\n",
