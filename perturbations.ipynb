    "# ── apply_perturbation_chains ─────────────────────────────────────────────────\n",
    "#\n",
    "# Runs every sampled permutation of transforms on each anchor row.\n",
    "# Returns a DataFrame with one row per successful intermediate step, plus:\n",
    "#\n",
    "#   flags            : list of string tags for this row (see below)\n",
    "#   stop_reason      : why the chain ended (only set on the *last* row of a\n",
    "#                      chain that was cut short; None otherwise)\n",
    "#   stop_transform   : which transform triggered the stop\n",
    "#\n",
    "# Flag values\n",
    "# ───────────────\n",
    "#  \"is_false\"        — is_true propagation resolved to \"false\"\n",
    "#  \"stub_transform\"  — a transform from _STUB_TRANSFORMS appears in the chain\n",
    "#                      (the stub always returns None so this row was generated\n",
    "#                       by the step *before* the stub)\n",
    "#  \"logical_fallacy\" — the same transform appears more than once in the chain\n",
    "#                      (applying a perturbation twice is often circular)\n",
    "#  \"chain_truncated\" — the chain was cut short for any stop_reason; placed on\n",
    "#                      the last successful row in the chain\n",
    "#\n",
    "# FAILURE_LOG entries (module-level list, reset on each call)\n",
    "# ──────────────────────────────────────────────────────────\n",
    "#  reason: \"return_none\"  — transform returned None\n",
    "#  reason: \"no_change\"    — output identical to input\n",
    "#  reason: \"compile_fail\" — Lean rejected the variant\n",
    "#  reason: \"exception\"    — transform raised an unexpected exception\n",
    "\n",
    "from collections import Counter as _Counter\n",
    "\n",
    "FAILURE_LOG: list[dict] = []\n",
    "\n",
    "def apply_perturbation_chains(\n",
    "    df: pd.DataFrame,\n",
    "    transforms: dict,\n",
    "    n_permutations: int = 6,\n",
    "    random_seed: int = 42,\n",
    ") -> pd.DataFrame:\n",
    "    global FAILURE_LOG\n",
    "    FAILURE_LOG = []\n",
    "    rng = random.Random(random_seed)\n",
    "    transform_names = list(transforms.keys())\n",
    "    all_permutations = list(permutations(transform_names))\n",
    "\n",
    "    results: list[dict] = []\n",
    "\n",
    "    for _, row in df.iterrows():\n",
    "        anchor_sig  = row[\"signature\"]\n",
    "        anchor_type = row[\"type\"]\n",
    "\n",
    "        k = min(n_permutations, len(all_permutations))\n",
    "        sampled_permutations = rng.sample(all_permutations, k)\n",
    "\n",
    "        for perm in sampled_permutations:\n",
    "            current_sig  = anchor_sig\n",
    "            current_type = anchor_type\n",
    "            applied_so_far: list[str] = []\n",
    "            chain_rows: list[dict] = []\n",
    "            stop_reason: str | None = None\n",
    "            stop_transform: str | None = None\n",
    "\n",
    "            for transform_name in perm:\n",
    "                fn = transforms[transform_name]\n",
    "\n",
    "                # ── Apply transform ──────────────────────────────────────────\n",
    "                try:\n",
    "                    result = fn(current_sig, current_type)\n",
    "                except Exception as exc:\n",
    "                    FAILURE_LOG.append({\n",
    "                        \"anchor_signature\": anchor_sig,\n",
    "                        \"transform\": transform_name,\n",
    "                        \"reason\": \"exception\",\n",
    "                        \"detail\": str(exc),\n",
    "                        \"applied_so_far\": list(applied_so_far),\n",
    "                    })\n",
    "                    stop_reason    = \"exception\"\n",
    "                    stop_transform = transform_name\n",
    "                    break\n",
    "\n",
    "                if result is None:\n",
    "                    is_stub = transform_name in _STUB_TRANSFORMS\n",
    "                    FAILURE_LOG.append({\n",
    "                        \"anchor_signature\": anchor_sig,\n",
    "                        \"transform\": transform_name,\n",
    "                        \"reason\": \"return_none\",\n",
    "                        \"is_stub\": is_stub,\n",
    "                        \"applied_so_far\": list(applied_so_far),\n",
    "                    })\n",
    "                    stop_reason    = \"return_none\"\n",
    "                    stop_transform = transform_name\n",
    "                    # Mark stub flag on the *previous* row in this chain\n",
    "                    if chain_rows and is_stub:\n",
    "                        if \"stub_transform\" not in chain_rows[-1][\"flags\"]:\n",
    "                            chain_rows[-1][\"flags\"].append(\"stub_transform\")\n",
    "                    break\n",
    "\n",
    "                variant_sig, variant_type = result\n",
    "\n",
    "                # ── No-change check ──────────────────────────────────────────\n",
    "                if (variant_sig.strip() == current_sig.strip()\n",
    "                        and variant_type.strip() == current_type.strip()):\n",
    "                    FAILURE_LOG.append({\n",
    "                        \"anchor_signature\": anchor_sig,\n",
    "                        \"transform\": transform_name,\n",
    "                        \"reason\": \"no_change\",\n",
    "                        \"applied_so_far\": list(applied_so_far),\n",
    "                    })\n",
    "                    stop_reason    = \"no_change\"\n",
    "                    stop_transform = transform_name\n",
    "                    break\n",
    "\n",
    "                # ── Lean compile check ───────────────────────────────────────\n",
    "                if not compile_lean(variant_sig, variant_type):\n",
    "                    FAILURE_LOG.append({\n",
    "                        \"anchor_signature\": anchor_sig,\n",
    "                        \"transform\": transform_name,\n",
    "                        \"reason\": \"compile_fail\",\n",
    "                        \"applied_so_far\": list(applied_so_far),\n",
    "                        \"variant_type\": variant_type,\n",
    "                    })\n",
    "                    stop_reason    = \"compile_fail\"\n",
    "                    stop_transform = transform_name\n",
    "                    break\n",
    "\n",
    "                # ── Step succeeded — build output row ────────────────────────\n",
    "                applied_so_far.append(transform_name)\n",
    "                truth = is_true(list(applied_so_far), variant_sig, variant_type)\n",
    "\n",
    "                flags: list[str] = []\n",
    "                if truth == \"false\":\n",
    "                    flags.append(\"is_false\")\n",
    "                if applied_so_far.count(transform_name) > 1:\n",
    "                    flags.append(\"logical_fallacy\")\n",
    "\n",
    "                chain_rows.append({\n",
    "                    \"anchor_signature\":      anchor_sig,\n",
    "                    \"anchor_type\":           anchor_type,\n",
    "                    \"variant_signature\":     variant_sig,\n",
    "                    \"variant_type\":          variant_type,\n",
    "                    \"perturbations_applied\": list(applied_so_far),\n",
    "                    \"chain_depth\":           len(applied_so_far),\n",
    "                    \"is_true\":               truth,\n",
    "                    \"flags\":                 flags,\n",
    "                    \"stop_reason\":           None,\n",
    "                    \"stop_transform\":        None,\n",
    "                })\n",
    "\n",
    "                current_sig  = variant_sig\n",
    "                current_type = variant_type\n",
    "\n",
    "            # ── Tag chain truncation on the last successful row ───────────────\n",
    "            if chain_rows and stop_reason is not None:\n",
    "                chain_rows[-1][\"stop_reason\"]   = stop_reason\n",
    "                chain_rows[-1][\"stop_transform\"] = stop_transform\n",
    "                if \"chain_truncated\" not in chain_rows[-1][\"flags\"]:\n",
    "                    chain_rows[-1][\"flags\"].append(\"chain_truncated\")\n",
    "\n",
    "            results.extend(chain_rows)\n",
    "\n",
    "    result_df = pd.DataFrame(results)\n",
    "    print(f\"Generated {len(result_df):,} compiled variants from {len(df):,} anchors\")\n",
    "    if len(result_df):\n",
    "        print(\"\\nChain depth distribution:\")\n",
    "        print(result_df[\"chain_depth\"].value_counts().sort_index().to_string())\n",
    "    if FAILURE_LOG:\n",
    "        reasons = _Counter(e[\"reason\"] for e in FAILURE_LOG)\n",
    "        print(f\"\\nFailure log: {sum(reasons.values())} entries\")\n",
    "        for reason, cnt in reasons.most_common():\n",
    "            print(f\"  {reason}: {cnt}\")\n",
    "    return result_df"
   ]
